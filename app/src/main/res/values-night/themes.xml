<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Cliché" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/strong_red</item>
        <item name="colorPrimaryVariant">@color/dark_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/strong_red</item>
        <item name="colorSecondaryVariant">@color/dark_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Tertiary brand color. -->
        <item name="colorTertiary">@color/strong_grey</item>
        <!-- Status bar. -->
        <item name="statusBarForeground">@color/strong_red</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Default Background. -->
        <item name="android:colorBackground">@color/strong_dark</item>
        <!-- Surface color. -->
        <item name="colorSurface">@color/dark</item>
        <item name="colorOnSurface">@color/grey</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
    </style>
</resources>